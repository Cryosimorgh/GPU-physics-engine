// Same accumulated projected Gauss-Seidel constraints as reference/sim.hlsl.
// Binary64 transient accumulators fix the independently demonstrated f32
// residual cancellation. G1 state and the acceptance envelope remain f32.
struct Body {double vx,vy,omega,im,ii;uint sleep;};
groupshared double3 velocities[G3_LOCAL_BODIES];
groupshared uint sleepState[G3_LOCAL_BODIES];
groupshared float2 masses[G3_LOCAL_BODIES];
groupshared double residuals[128];
groupshared uint localMode;
Body bodyAt(uint i,uint local){Body b=(Body)0;if(i>=n)return b;if(localMode){double3 v=velocities[local];b.vx=v.x;b.vy=v.y;b.omega=v.z;b.sleep=sleepState[local];b.im=masses[local].x;b.ii=masses[local].y;}else{b.vx=md(AT(WORK_VX,i));b.vy=md(AT(WORK_VY,i));b.omega=md(AT(WORK_OMEGA,i));b.sleep=trial.Load(4*(13*capacity+i));b.im=val(i,6);b.ii=val(i,7);}return b;}
void storeBody(uint i,uint local,Body b){if(localMode){velocities[local]=double3(b.vx,b.vy,b.omega);sleepState[local]=b.sleep;}else{mdstore(AT(WORK_VX,i),b.vx);mdstore(AT(WORK_VY,i),b.vy);mdstore(AT(WORK_OMEGA,i),b.omega);trial.Store(4*(13*capacity+i),b.sleep);if(b.sleep==0)trial.Store(4*(14*capacity+i),1);}}
double tolerance(Body a,Body b,double target){return 32.0*double(U)*max(.001,max(abs(target),max(max(abs(a.vx),abs(a.vy)),max(abs(b.vx),abs(b.vy)))));}
double relative(uint o,bool tangent,bool rounded){uint packed=c.Load(o+60);Body a=bodyAt(c.Load(o),packed&65535),b=bodyAt(c.Load(o+4),packed>>16);if(rounded){a.vx=double(float(a.vx));a.vy=double(float(a.vy));a.omega=double(float(a.omega));b.vx=double(float(b.vx));b.vy=double(float(b.vy));b.omega=double(float(b.omega));}double nx=cf(o,3),ny=cf(o,4);return tangent?(a.vx-b.vx)*(-ny)+(a.vy-b.vy)*nx-a.omega*double(cf(o,6))-b.omega*double(cf(o,7)):(a.vx-b.vx)*nx+(a.vy-b.vy)*ny;}
void delta(uint o,double dl,double ft){uint i=c.Load(o),j=c.Load(o+4),packed=c.Load(o+60);double nx=cf(o,3),ny=cf(o,4),ix=nx*dl-ny*ft,iy=ny*dl+nx*ft;Body a=bodyAt(i,packed&65535);a.vx+=ix*a.im;a.vy+=iy*a.im;a.omega-=ft*double(cf(o,6))*a.ii;if(dl!=0||ft!=0){if(a.sleep>=sleep_frames)markWake(i);a.sleep=0;}storeBody(i,packed&65535,a);if(j<n){Body b=bodyAt(j,packed>>16);b.vx-=ix*b.im;b.vy-=iy*b.im;b.omega-=ft*double(cf(o,7))*b.ii;if(dl!=0||ft!=0){if(b.sleep>=sleep_frames)markWake(j);b.sleep=0;}storeBody(j,packed>>16,b);}}
// Bounded normal projected over-relaxation for large islands. The projection
// keeps lambda_n nonnegative; the existing tangent update reclamps against
// the updated Coulomb bound. Islands below 64 retain the qualified PGS path (the 32-body
// friction control regresses under the large-island relaxation factor).
// Acceptance still uses the original rounded-state KKT test and rollback.
static const double largeIslandRelaxation=1.995;
void applyColor(uint r,uint col,uint lane,bool rebuild){double relaxation=m.Load(AT(SIZE,r))>=64?largeIslandRelaxation:1.0;uint base=uint(get64(AT(COLOR_BASE,r))),first=c.Load(CT(COLOR_START,base+col)),end=c.Load(CT(COLOR_START,base+col+1));for(uint begin=first;begin<end;begin+=128){if(begin+lane<end){uint o=CT(CONTACT,c.Load(CT(COLORED,begin+lane)));if(rebuild){double ln=readLambda(o,false),lt=readLambda(o,true);if(ln!=0||lt!=0)delta(o,ln,lt);}else{double kn=cf(o,8),ln=readLambda(o,false);if(kn>0){double next=max(0.0,ln+relaxation*(double(cf(o,5))-relative(o,false,false))/kn);if(next!=ln){writeLambda(o,false,next);delta(o,next-ln,0);}}double kt=cf(o,9);if(kt>0){double lt=readLambda(o,true),bound=contactMu(o)*readLambda(o,false),next=clamp(lt-relative(o,true,false)/kt,-bound,bound);if(next!=lt){writeLambda(o,true,next);delta(o,0,next-lt);}}c.Store(o+8,c.Load(o+8)+1);}}if(localMode)GroupMemoryBarrierWithGroupSync();else DeviceMemoryBarrierWithGroupSync();}}
double measure(uint r,uint lane){double ratio=0;uint begin=uint(get64(AT(CONTACT_START,r))),end=begin+m.Load(AT(CONTACT_COUNT,r));for(uint ci=begin+lane;ci<end;ci+=128){uint o=CT(CONTACT,c.Load(CT(ROOT_CONTACTS,ci))),packed=c.Load(o+60);Body a=bodyAt(c.Load(o),packed&65535),b=bodyAt(c.Load(o+4),packed>>16);double tol=tolerance(a,b,double(cf(o,5))),kn=cf(o,8),ln=readLambda(o,false),q=relative(o,false,true)-double(cf(o,5)),res=normalResidual(q,kn,ln);ratio=max(ratio,res/tol);double kt=cf(o,9);if(kt>0){double lt=readLambda(o,true),bound=contactMu(o)*ln;ratio=max(ratio,contactTangentResidual(o,relative(o,true,true),kt,ln,lt)/tol);}}residuals[lane]=ratio;GroupMemoryBarrierWithGroupSync();for(uint step=64;step>0;step/=2){if(lane<step)residuals[lane]=max(residuals[lane],residuals[lane+step]);GroupMemoryBarrierWithGroupSync();}return residuals[0];}
void loadIsland(uint r,uint lane,bool freeState){uint start=uint(get64(AT(MEMBER_START,r))),size=m.Load(AT(SIZE,r));for(uint mi=lane;mi<size;mi+=128){uint i=m.Load(AT(MEMBERS,start+mi)),local=m.Load(AT(LOCAL,i));if(localMode)masses[local]=float2(val(i,6),val(i,7));Body b=(Body)0;b.im=val(i,6);b.ii=val(i,7);b.vx=freeState?double(asfloat(m.Load(AT(FREE_VX,i)))):md(AT(WORK_VX,i));b.vy=freeState?double(asfloat(m.Load(AT(FREE_VY,i)))):md(AT(WORK_VY,i));b.omega=freeState?double(asfloat(m.Load(AT(FREE_OMEGA,i)))):md(AT(WORK_OMEGA,i));b.sleep=freeState?m.Load(AT(FREE_SLEEP,i)):trial.Load(4*(13*capacity+i));storeBody(i,local,b);}if(localMode)GroupMemoryBarrierWithGroupSync();else DeviceMemoryBarrierWithGroupSync();}
void storeIsland(uint r,uint lane,bool mark){uint start=uint(get64(AT(MEMBER_START,r))),size=m.Load(AT(SIZE,r));for(uint mi=lane;mi<size;mi+=128){uint i=m.Load(AT(MEMBERS,start+mi));Body b=bodyAt(i,m.Load(AT(LOCAL,i)));if(localMode){mdstore(AT(WORK_VX,i),b.vx);mdstore(AT(WORK_VY,i),b.vy);mdstore(AT(WORK_OMEGA,i),b.omega);}put(i,2,float(b.vx));put(i,3,float(b.vy));put(i,5,float(b.omega));trial.Store(4*(13*capacity+i),b.sleep);if(b.sleep==0)trial.Store(4*(14*capacity+i),1);if(mark){uint old;m.InterlockedOr(AT(SOLVER_FLAG,i),1,old);if((old&1)==0)m.InterlockedAdd(32,1);}}DeviceMemoryBarrierWithGroupSync();}
[numthreads(128,1,1)]void ph_ready(uint3 g:SV_GroupID,uint3 l:SV_GroupThreadID){uint q=islandIndex(g),lane=l.x;if(q>=m.Load(16))return;if(lane==0)blocked=stopped()?1:0;GroupMemoryBarrierWithGroupSync();if(blocked)return;uint r=m.Load(AT(ROOTS,q));if(m.Load(AT(ROOT_DIRTY,r))==0)return;if(lane==0)localMode=m.Load(AT(SIZE,r))<=G3_LOCAL_BODIES?1:0;GroupMemoryBarrierWithGroupSync();loadIsland(r,lane,true);for(uint col=0;col<m.Load(AT(COLORS,r));col++)applyColor(r,col,lane,true);double ratio=measure(r,lane);storeIsland(r,lane,false);if(lane==0){m.Store(AT(RATIO,r),asuint(float(ratio)));if(!isfinite(float(ratio))){fail(16);return;}if(ratio>1){if((flags&G4_GUARDED_FLAG)!=0){uint64_t tokens=(128ull+uint64_t(m.Load(AT(SIZE,r)))+4ull*m.Load(AT(CONTACT_COUNT,r)))*uint64_t(iterations);uint budget=m.Load(G4_BUDGET_BYTE),previous;if(tokens>budget){fail(G4_ADMISSION_ERROR);return;}m.InterlockedAdd(G4_SPENT_BYTE,uint(tokens),previous);if(previous>budget-uint(tokens)){fail(G4_ADMISSION_ERROR);return;}}uint at;m.InterlockedAdd(20,1,at);if(at>=G3_ROOT_BOUND(n,flags)){fail(64);return;}m.Store(AT(QUEUE,at),r);m.InterlockedMax(72,at+1);}}}
[numthreads(128,1,1)]void ph_solve(uint3 g:SV_GroupID,uint3 l:SV_GroupThreadID){uint q=islandIndex(g),lane=l.x;if(q>=m.Load(20))return;if(lane==0)blocked=stopped()?1:0;GroupMemoryBarrierWithGroupSync();if(blocked)return;uint r=m.Load(AT(QUEUE,q));if(lane==0){localMode=m.Load(AT(SIZE,r))<=G3_LOCAL_BODIES?1:0;uint prior;m.InterlockedOr(AT(ROOT_DIRTY,r),2,prior);if(prior&2)fail(64);m.InterlockedAdd(36,1);}GroupMemoryBarrierWithGroupSync();loadIsland(r,lane,false);double ratio=0;uint it=0,colors=m.Load(AT(COLORS,r)),count=m.Load(AT(CONTACT_COUNT,r)),limit=min(iterations,max_work/max(1u,count));for(;it<limit;it++){for(uint col=0;col<colors;col++)applyColor(r,col,lane,false);DeviceMemoryBarrierWithGroupSync();ratio=measure(r,lane);if(ratio<=1||((it+1)&7)==0||it+1==limit){loadIsland(r,lane,true);for(uint col=0;col<colors;col++)applyColor(r,col,lane,true);DeviceMemoryBarrierWithGroupSync();ratio=measure(r,lane);}if(ratio<=1){it++;break;}}storeIsland(r,lane,true);if(lane==0){m.Store(AT(RATIO,r),asuint(float(ratio)));m.InterlockedAdd(AT(ITERATIONS,r),it);uint previous;m.InterlockedAdd(40,it,previous);if(previous>0xffffffffu-it)fail(64);m.InterlockedMax(44,it);if(fixture>=9u)m.InterlockedAdd(G4_ITERATION_HISTOGRAM_BYTE+4*(it==0?0:min(7u,1+firstbithigh(it))),1);if(!isfinite(float(ratio))||ratio>1)fail(2);}}
