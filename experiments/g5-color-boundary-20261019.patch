diff --git a/test_color_boundary.py b/test_color_boundary.py
new file mode 100644
index 0000000..05bd3c0
--- /dev/null
+++ b/test_color_boundary.py
@@ -0,0 +1,20 @@
+"""Contracts for the one global-memory barrier-coalescing experiment."""
+from pathlib import Path
+import unittest
+
+class ColorBoundaryContracts(unittest.TestCase):
+    def test_redundant_boundary_is_conditional_and_global_only(self):
+        source=Path('projected_solver.hlsl').read_text()
+        self.assertIn('void g5ColorBoundary(uint colors)',source)
+        self.assertIn('if(localMode==1||colors==0)DeviceMemoryBarrierWithGroupSync();',source)
+        self.assertEqual(source.count('g5ColorBoundary(colors);'),2)
+        self.assertIn('#define G5_COALESCE_COLOR_BARRIER 0',source)
+
+    def test_paired_interval_does_not_invent_a_gain(self):
+        from measure_color_boundary import paired_interval
+        same=paired_interval([1.0]*8)
+        self.assertEqual(same,dict(ratio=1.0,lower95=1.0,upper95=1.0))
+        gain=paired_interval([.9]*8)
+        self.assertAlmostEqual(gain['upper95'],.9)
+
+if __name__=='__main__':unittest.main()
