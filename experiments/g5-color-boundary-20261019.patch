+"""One bounded, serialized deterministic control/candidate GPU comparison."""
+from pathlib import Path
+from collections import Counter
+import csv
+import hashlib
+import json
+import math
+import os
+import random
+import shutil
+import statistics
+import struct
+import sys
+import subprocess
+
+from dev_test import ROOT, Workflow, dependencies, sdk
+from measure_repeatability import digest, extract, stats
+from measure_deterministic import timing
+from sweep_g5 import execute, fixture, require, percentile
+
+def paired_interval(ratios):
+    """Fixed-seed paired bootstrap on log ratios; exploratory, not tail latency."""
+    require(bool(ratios) and all(x>0 for x in ratios),'invalid paired ratios')
+    rng=random.Random(51019)
+    logs=list(map(math.log,ratios))
+    draws=sorted(math.exp(statistics.mean(rng.choices(logs,k=len(logs)))) for _ in range(5000))
+    return dict(ratio=math.exp(statistics.mean(logs)),lower95=draws[124],upper95=draws[4874])
+
+def impulse_hash(row):
+    raw=json.loads(Path(row['raw_json']).read_text())
+    data=Path(row['raw_json']+'-contacts-1.bin').read_bytes()
+    count=row['proof']['actual_contacts'];capacity=raw['contact_capacity']
+    return hashlib.sha256(data[108*capacity:108*capacity+8*count]+data[116*capacity:116*capacity+8*count]).hexdigest()
+
+def main():
+    out=ROOT/(ROOT/'dev-test-results/color-boundary-current.txt').read_text()
+    require(not (out/'results.json').exists() and not (out/'progress.json').exists(),'do not repeat GPU cases')
+    w=Workflow(out);lock=w.cache/'running.lock'
+    fd=os.open(lock,os.O_CREAT|os.O_EXCL|os.O_WRONLY);os.write(fd,str(os.getpid()).encode());os.close(fd)
+    runs=[]
+    try:
+        w.run('unit-tests',[sys.executable,'-m','unittest','test_dev_workflow','test_sweep_g5','test_global_profile','test_repeatability','test_color_boundary','-q'],timeout=60)
+        previous=ROOT/'dev-test-results/g5-deterministic-20261019T035548203177Z'
+        baseline=json.loads((previous/'results.json').read_text())
+        require(digest(out/'control-projected_solver.hlsl')==baseline['source_sha256']['projected_solver.hlsl'],'wrong retained control')
+        builds={};static={}
+        for policy in range(5):
+            for arm,enabled in [('control',0),('candidate',1)]:
+                dest=out/f'{arm}-policy-{policy}';dest.mkdir()
+                old=previous/f'deterministic-policy-{policy}'
+                ref=baseline['builds'][f'deterministic-{policy}']['sha256']
+                for name,expected in ref.items():
+                    require(digest(old/name)==expected,'cached artifact mismatch '+name)
+                    shutil.copy2(old/name,dest/name)
+                shader=dest/'ph_solve.dxil'
+                command=[sdk()[1],'-T','cs_6_0','-Gis','-D',f'G5_RELAXATION_POLICY={policy}',
+                    '-D','G5_BODY_CACHE=0','-D','G5_REUSE_MEASURE_BODIES=1',
+                    '-D','G5_SKIP_OVERWRITTEN_RESIDUAL=1','-D','G5_EARLY_RESIDUAL_RESTART=0',
+                    '-D',f'G5_COALESCE_COLOR_BARRIER={enabled}','-E','ph_solve','-Fo',shader,ROOT/'physics.hlsl']
+                w.build(f'color-boundary-{arm}-{policy}',['physics.hlsl'],[shader.relative_to(ROOT).as_posix()],command)
+                if not enabled:require(digest(shader)==ref['ph_solve.dxil'],'control DXIL differs from retained baseline')
+                r=subprocess.run([sdk()[1],'-dumpbin',shader],capture_output=True,text=True,check=True)
+                (out/f'{arm}-{policy}-dxil.txt').write_text(r.stdout)
+                static[f'{arm}-{policy}']=dict(barriers=r.stdout.count('call void @dx.op.barrier'),
+                    lines=len(r.stdout.splitlines()),sha256=digest(shader))
+                builds[f'{arm}-{policy}']=dict(exe=str(dest/'physics.exe'),sha256={name:digest(dest/name) for name in ref})
+        names=set(dependencies(['physics.hlsl','physics.c']))|{
+            'measure_color_boundary.py','test_color_boundary.py','measure_deterministic.py',
+            'measure_repeatability.py','sweep_g5.py','dev_test.py','profile_islands.py','profile_global.py'}
+        sources={n:digest(ROOT/n) for n in sorted(names)}
+        cases=[]
+        for topology in ('chain','branching','dense','oblique'):
+            for n in ([16,64,256,1024] if topology=='chain' else [64,256]):
+                path=out/f'{topology}-{n}.bin';description,expected=fixture(topology,n,path)
+                cases.append((topology,n,path,description,expected))
+        rule=dict(primary='policy4 chain1024 solver gain exceeds max(3.6%, paired control A/A p95 deviation); paired bootstrap upper95<1',
+            aggregate='equal-fixture policy4 complete-tick geometric ratio upper95<1',
+            correctness='all policies exactly match statuses, iterations, schedules, FP64 work/impulses and published state; existing independent audits',
+            repeats='8 paired policy4 samples/fixture; one pair/fixture for policies0..3; 240 main trials total',
+            no_p99_or_sustained_claim=True)
+        (out/'prepared.json').write_text(json.dumps(dict(sources=sources,builds=builds,rule=rule,static=static),indent=2))
+        device=None
+        for sample in range(8):
+            for topology,n,path,description,expected in cases:
+                policies=[4]+(list(range(4)) if sample==0 else [])
+                for policy in policies:
+                    for arm in (['control','candidate'] if sample%2==0 else ['candidate','control']):
+                        require(digest(path)==description['input_sha256'],'fixture changed')
+                        folder=out/'runs'/arm;folder.mkdir(parents=True,exist_ok=True)
+                        row=execute(builds[f'{arm}-{policy}']['exe'],folder,topology,n,f'Policy{policy}',sample,path,expected,30)
+                        runs.append(row);row.update(arm=arm,policy=policy)
+                        require(row['status'] in ('CONVERGED','REJECTED'),'unexpected case failure '+str(row.get('error')))
+                        row['signatures'],actual=extract(row)
+                        row['signatures']['impulses_sha256']=impulse_hash(row)
+                        row['scheduling_us']=timing(row)
+                        if device is None:device=actual
+                        require(device==actual,'device changed')
+                        # The final greedy color must contain real work; its
+                        # final global-memory batch supplies the removed fence.
+                        require(row['signatures']['color_sizes'][-1]>0,'empty final color')
+                        (out/'progress.json').write_text(json.dumps(runs,indent=2))
+        require(sources=={n:digest(ROOT/n) for n in sources},'source changed during batch')
+        require(all(b['sha256']=={n:digest(Path(b['exe']).parent/n) for n in b['sha256']} for b in builds.values()),'binary changed')
+        for topology,n,_,_,_ in cases:
+            for policy in range(5):
+                selected=[r for r in runs if (r['topology'],r['n'],r['policy'])==(topology,n,policy)]
+                require(len({r['status'] for r in selected})==1,'convergence regression')
+                require(len({r['proof']['solver_iterations'] for r in selected})==1,'iterations changed')
+                for key in selected[0]['signatures']:
+                    require(len({json.dumps(r['signatures'][key],sort_keys=True) for r in selected})==1,'schedule/numerical difference '+key)
+        summary=[];ratio_sets=[]
+        for topology,n,_,_,_ in cases:
+            selected={a:[r for r in runs if (r['topology'],r['n'],r['policy'],r['arm'])==(topology,n,4,a)] for a in ('control','candidate')}
+            row=dict(topology=topology,n=n,iterations=selected['control'][0]['proof']['solver_iterations'],
+                contacts=selected['control'][0]['proof']['actual_contacts'])
+            for a,rows in selected.items():
+                row[a]={k:stats(vals) for k,vals in dict(gpu_us=[r['gpu_stage_us']['total'] for r in rows],
+                    solver_us=[r['gpu_stage_us']['solver'] for r in rows],
+                    scheduling_us=[r['scheduling_us']['total_us'] for r in rows],
+                    cpu_us=[r['cpu_submit_us'] for r in rows]).items()}
+            ratios={k:[b['gpu_stage_us'][k]/a['gpu_stage_us'][k] for a,b in zip(selected['control'],selected['candidate'])] for k in ('solver','total')}
+            row['paired']={k:paired_interval(v) for k,v in ratios.items()}
+            control=[r['gpu_stage_us']['solver'] for r in selected['control']]
+            row['control_aa_p95_deviation']=percentile([abs(control[i+1]/control[i]-1) for i in range(0,8,2)],.95)
+            summary.append(row);ratio_sets.append(ratios['total'])
+        rng=random.Random(51020);draws=[]
+        for _ in range(5000):
+            draws.append(math.exp(statistics.mean(statistics.mean(math.log(rng.choice(v)) for _ in v) for v in ratio_sets)))
+        draws.sort();aggregate=dict(ratio=math.exp(statistics.mean(math.log(s['paired']['total']['ratio']) for s in summary)),upper95=draws[4874],lower95=draws[124])
+        large=next(s for s in summary if s['topology']=='chain' and s['n']==1024)
+        floor=max(.036,large['control_aa_p95_deviation'])
+        retain=large['paired']['solver']['upper95']<1 and large['paired']['solver']['ratio']<1-floor and aggregate['upper95']<1
+        result=dict(decision='RETAIN' if retain else 'REJECT_PERFORMANCE_NOT_DISTINGUISHABLE_OR_AGGREGATE',qualification=False,
+            correctness='PASS_EXACT_MATCH',rule=rule,primary_noise_floor=floor,aggregate=aggregate,
+            summary=summary,runs=runs,device=device,sources=sources,builds=builds,static=static,build_actions=w.actions)
+        (out/'results.json').write_text(json.dumps(result,indent=2))
+        flat=[]
+        for s in summary:
+            for a in ('control','candidate'):
+                flat.append(dict(topology=s['topology'],n=s['n'],arm=a,iterations=s['iterations'],contacts=s['contacts'],
+                    **{k+'_p50':v['median'] for k,v in s[a].items()},**{k+'_cv_pct':v['cv_pct'] for k,v in s[a].items()}))
+        with (out/'summary.csv').open('w',newline='') as f:
+            writer=csv.DictWriter(f,fieldnames=list(flat[0]));writer.writeheader();writer.writerows(flat)
+        print('Fixture N iterations solver ms C->T | tick ms C->T | schedule ms C->T | CPU ms C->T | solver ratio [95%]')
+        for s in summary:
+            pairs=['%.3f->%.3f'%(s['control'][k]['median']/1000,s['candidate'][k]['median']/1000) for k in ('solver_us','gpu_us','scheduling_us','cpu_us')]
+            q=s['paired']['solver'];print(s['topology'],s['n'],s['iterations'],' | '.join(pairs),' %.4f [%.4f,%.4f]'%(q['ratio'],q['lower95'],q['upper95']))
+        print('Decision:',result['decision'],'primary floor:',floor,'aggregate:',aggregate)
+        print('Correctness:',result['correctness'],'statuses:',dict(Counter((r['arm'],r['status']) for r in runs)))
+        print('Evidence:',out)
+    except Exception as e:
+        (out/'failure.json').write_text(json.dumps(dict(error=str(e),runs=runs),indent=2));raise
+    finally:lock.unlink()
+
+if __name__=='__main__':main()
