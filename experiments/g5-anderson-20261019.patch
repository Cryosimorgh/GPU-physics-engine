+        require(sources=={n:digest(ROOT/n) for n in sources},'source changed during batch')
+        require(all(b['sha256']=={n:digest(Path(b['exe']).parent/n) for n in b['sha256']} for b in builds.values()),'binary changed')
+        regressions=[]
