+"""Small fixed-point/scratch contracts; existing GPU audits verify physics."""
+from pathlib import Path
+import unittest
+
+class AndersonContracts(unittest.TestCase):
+    def test_scalar_fixed_point_secant(self):
+        old_f,old_r,f,r=1.,1.,1.9,.9
+        gamma=(r-old_r)*r/((r-old_r)**2)
+        self.assertAlmostEqual(f-gamma*(f-old_f),10.)
+
+    def test_opt_in_projection_and_budget_guards(self):
+        source=Path('projected_solver.hlsl').read_text()
+        self.assertIn('#define G5_ANDERSON 0',source)
+        helper=Path('anderson-acceleration.hlsl').read_text()
+        self.assertIn('48ull*uint64_t(total)',helper)
+        self.assertIn('max(0.0',helper)
+        self.assertIn('clamp(',helper)
+        self.assertIn('it+1+aaCost+6<=limit',source)
+        self.assertIn('raw<baseRaw&&ratio<=baseRatio',source)
+
+if __name__=='__main__':unittest.main()
