+                        folder=out/'runs'/arm;folder.mkdir(parents=True,exist_ok=True)
+                        row=execute(builds[f'{arm}-{policy}']['exe'],folder,topology,n,f'Policy{policy}',sample,path,expected,30)
+                        runs.append(row);row.update(arm=arm,policy=policy)
+                        require(row['status'] in ('CONVERGED','REJECTED'),'unexpected case failure '+str(row.get('error')))
+                        row['signatures'],actual=extract(row)
+                        row['signatures']['impulses_sha256']=impulse_hash(row)
+                        row['scheduling_us']=timing(row)
+                        if arm=='candidate':row['anderson']=aa_telemetry(row)
+                        if device is None:device=actual
+                        require(device==actual,'device changed')
+                        # Keep verifying the canonical schedule and nonempty
+                        # final color; all barriers remain unchanged.
+                        require(row['signatures']['color_sizes'][-1]>0,'empty final color')
+                        (out/'progress.json').write_text(json.dumps(runs,indent=2))
+        traces=[]
+        for arm,enabled in [('control',0),('candidate',1)]:
+            dest=out/f'{arm}-trace';shutil.copytree(out/f'{arm}-policy-4',dest)
+            shader=dest/'ph_solve.dxil'
+            command=[sdk()[1],'-T','cs_6_0','-Gis','-D','G5_RELAXATION_POLICY=4','-D','G5_BODY_CACHE=0','-D','G5_TRACE=1','-D',f'G5_ANDERSON={enabled}','-E','ph_solve','-Fo',shader,ROOT/'physics.hlsl']
+            w.build('anderson-trace-'+arm,['physics.hlsl'],[shader.relative_to(ROOT).as_posix()],command)
+            for topology,n,path,description,expected in cases:
+                folder=out/'traces'/arm;folder.mkdir(parents=True,exist_ok=True)
+                row=execute(dest/'physics.exe',folder,topology,n,'AdaptiveTrace',0,path,expected,30)
+                require(row['status'] in ('CONVERGED','REJECTED'),'trace probe failure '+str(row.get('error')))
+                row.update(arm=arm)
+                if arm=='candidate':row['anderson']=aa_telemetry(row)
