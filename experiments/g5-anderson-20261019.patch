+// Optional, topology-independent depth-one Anderson on an eight-sweep map.
+// Three FP64 impulse vectors occupy checked unused contact-record bytes.
+// No new allocation, equations, contact ordering, or production default.
+#if G5_ANDERSON
+groupshared double aaNumerator[128],aaDenominator[128];
+double aaLoad(uint o){uint2 v=c.Load2(o);return asdouble(v.x,v.y);}
+void aaStore(uint o,double v){uint lo,hi;asuint(v,lo,hi);c.Store2(o,uint2(lo,hi));}
+bool aaAwake(uint r,uint lane){
+ uint start=uint(get64(AT(MEMBER_START,r))),count=m.Load(AT(SIZE,r));double awake=1;
+ for(uint j=lane;j<count;j+=128)if(m.Load(AT(FREE_SLEEP,m.Load(AT(MEMBERS,start+j))))>=sleep_frames)awake=0;
+ aaNumerator[lane]=awake;GroupMemoryBarrierWithGroupSync();
+ for(uint s=64;s>0;s/=2){if(lane<s)aaNumerator[lane]=min(aaNumerator[lane],aaNumerator[lane+s]);GroupMemoryBarrierWithGroupSync();}
+ // A rejected extrapolation must not leave speculative wake side effects.
+ // Sleeping islands use the unchanged solver instead of trial impulses.
+ return aaNumerator[0]!=0;
+}
+bool aaStorage(uint r,out uint base){
+ uint total=m.Load(8),queues=m.Load(20);
+ uint64_t start=80ull*uint64_t(total),end;
+#if G5_TRACE
+ start+=80ull*66ull*uint64_t(queues);
+#endif
+ end=start+48ull*uint64_t(total)+80ull*uint64_t(queues);
+#if G5_PROFILE_COUNTS
+ end+=80ull;
+#endif
+ base=0;
+ if(total==0||end>80ull*uint64_t(contact_capacity)||end>0xffffffffull)return false;
+ base=uint(start+48ull*get64(AT(CONTACT_START,r)));return true;
+}
+void aaInput(uint r,uint lane,uint base){
+ uint first=uint(get64(AT(CONTACT_START,r))),count=m.Load(AT(CONTACT_COUNT,r));
+ for(uint j=lane;j<count;j+=128){uint o=CT(CONTACT,c.Load(CT(ROOT_CONTACTS,first+j)));aaStore(base+48*j,readLambda(o,false));aaStore(base+48*j+8,readLambda(o,true));}
+ DeviceMemoryBarrierWithGroupSync();
+}
+double aaCoefficient(uint r,uint lane,uint base,bool history){
+ double numerator=0,denominator=0;
+ uint first=uint(get64(AT(CONTACT_START,r))),count=m.Load(AT(CONTACT_COUNT,r));
+ for(uint j=lane;j<count;j+=128){uint o=CT(CONTACT,c.Load(CT(ROOT_CONTACTS,first+j)));
+  for(uint d=0;d<2;d++){uint at=base+48*j+8*d;double f=readLambda(o,d!=0),step=f-aaLoad(at),y=history?step-aaLoad(at+16):0;
+   numerator+=y*step;denominator+=y*y;aaStore(at,f);aaStore(at+16,step);}
+ }
+ aaNumerator[lane]=numerator;aaDenominator[lane]=denominator;GroupMemoryBarrierWithGroupSync();
+ for(uint s=64;s>0;s/=2){if(lane<s){aaNumerator[lane]+=aaNumerator[lane+s];aaDenominator[lane]+=aaDenominator[lane+s];}GroupMemoryBarrierWithGroupSync();}
+ double gamma=aaDenominator[0]>1.e-300?aaNumerator[0]/aaDenominator[0]:0;
+ return isfinite(float(gamma))?clamp(gamma,-32.0,32.0):0;
+}
+void aaTrial(uint r,uint lane,uint base,double gamma,bool trial){
+ uint first=uint(get64(AT(CONTACT_START,r))),count=m.Load(AT(CONTACT_COUNT,r));
+ for(uint j=lane;j<count;j+=128){uint o=CT(CONTACT,c.Load(CT(ROOT_CONTACTS,first+j))),at=base+48*j;
+  double fn=aaLoad(at),ft=aaLoad(at+8);
+  if(trial){double ln=max(0.0,fn-gamma*(fn-aaLoad(at+32))),bound=contactMu(o)*ln,lt=clamp(ft-gamma*(ft-aaLoad(at+40)),-bound,bound);writeLambda(o,false,ln);writeLambda(o,true,lt);}
+  aaStore(at+32,fn);aaStore(at+40,ft);
+ }
+ DeviceMemoryBarrierWithGroupSync();
+}
+void aaRestore(uint r,uint lane,uint base){
+ uint first=uint(get64(AT(CONTACT_START,r))),count=m.Load(AT(CONTACT_COUNT,r));
+ for(uint j=lane;j<count;j+=128){uint o=CT(CONTACT,c.Load(CT(ROOT_CONTACTS,first+j)));writeLambda(o,false,aaLoad(base+48*j));writeLambda(o,true,aaLoad(base+48*j+8));}
+ DeviceMemoryBarrierWithGroupSync();
+}
+void aaDiagnostics(uint queue,uint lane,bool enabled,uint attempts,uint accepted,uint rejected,uint charged,uint completed){
+ if(lane!=0)return;uint queues=m.Load(20);
+ uint64_t end=uint64_t(contact_capacity);
+#if G5_PROFILE_COUNTS
+ if(end==0)return;end--;
+#endif
+ if(end<uint64_t(m.Load(8))+queues)return;
+ uint o=uint(80ull*(end-queues+queue));
+ c.Store4(o,uint4(0x47354141,1,enabled?1:0,completed));c.Store4(o+16,uint4(attempts,accepted,rejected,charged));
+}
+#endif
