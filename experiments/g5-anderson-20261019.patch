+"""One bounded, serialized deterministic control/candidate GPU comparison."""
+from pathlib import Path
+from collections import Counter
+import csv
+import hashlib
+import json
+import math
+import os
+import random
+import shutil
+import statistics
+import struct
+import sys
+import subprocess
+
+from dev_test import ROOT, Workflow, dependencies, sdk
+from measure_repeatability import digest, extract, stats
+from measure_deterministic import timing
+from sweep_g5 import execute, fixture, require, percentile
+
+def paired_interval(ratios):
+    """Fixed-seed paired bootstrap on log ratios; exploratory, not tail latency."""
+    require(bool(ratios) and all(x>0 for x in ratios),'invalid paired ratios')
+    rng=random.Random(51019)
+    logs=list(map(math.log,ratios))
+    draws=sorted(math.exp(statistics.mean(rng.choices(logs,k=len(logs)))) for _ in range(5000))
+    return dict(ratio=math.exp(statistics.mean(logs)),lower95=draws[124],upper95=draws[4874])
+
+def impulse_hash(row):
+    raw=json.loads(Path(row['raw_json']).read_text())
+    data=Path(row['raw_json']+'-contacts-1.bin').read_bytes()
+    count=row['proof']['actual_contacts'];capacity=raw['contact_capacity']
+    return hashlib.sha256(data[108*capacity:108*capacity+8*count]+data[116*capacity:116*capacity+8*count]).hexdigest()
+
+def aa_telemetry(row):
+    raw=json.loads(Path(row['raw_json']).read_text())
+    data=Path(row['raw_json']+'-contacts-1.bin').read_bytes()
+    values=struct.unpack_from('<8I',data,80*(raw['contact_capacity']-1))
+    require(values[:2]==(0x47354141,1),'missing Anderson telemetry')
+    result=dict(enabled=values[2],sweeps=values[3],attempts=values[4],accepted=values[5],rejected=values[6],charged_work=values[7])
+    require(result['sweeps']==row['proof']['solver_iterations'] and result['sweeps']+result['charged_work']<=4096,'Anderson work budget exceeded')
+    require(result['attempts']==result['accepted']+result['rejected'] and result['attempts']<=64,'Anderson attempt accounting')
+    return result
+
+def main():
+    out=ROOT/(ROOT/'dev-test-results/anderson-current.txt').read_text()
+    require(not (out/'results.json').exists() and not (out/'progress.json').exists(),'do not repeat GPU cases')
+    w=Workflow(out);lock=w.cache/'running.lock'
+    fd=os.open(lock,os.O_CREAT|os.O_EXCL|os.O_WRONLY);os.write(fd,str(os.getpid()).encode());os.close(fd)
+    runs=[]
+    try:
+        w.run('unit-tests',[sys.executable,'-m','unittest','test_dev_workflow','test_sweep_g5','test_global_profile','test_repeatability','test_anderson','-q'],timeout=60)
+        previous=ROOT/'dev-test-results/g5-deterministic-20261019T035548203177Z'
+        baseline=json.loads((previous/'results.json').read_text())
+        require(digest(out/'control-projected_solver.hlsl')==baseline['source_sha256']['projected_solver.hlsl'],'wrong retained control')
+        builds={};static={}
+        for policy in range(5):
+            for arm,enabled in [('control',0),('candidate',1)]:
+                dest=out/f'{arm}-policy-{policy}';dest.mkdir(exist_ok=True)
+                old=previous/f'deterministic-policy-{policy}'
+                ref=baseline['builds'][f'deterministic-{policy}']['sha256']
+                for name,expected in ref.items():
+                    require(digest(old/name)==expected,'cached artifact mismatch '+name)
+                    shutil.copy2(old/name,dest/name)
+                shader=dest/'ph_solve.dxil'
+                command=[sdk()[1],'-T','cs_6_0','-Gis','-D',f'G5_RELAXATION_POLICY={policy}',
+                    '-D','G5_BODY_CACHE=0','-D','G5_REUSE_MEASURE_BODIES=1',
+                    '-D','G5_SKIP_OVERWRITTEN_RESIDUAL=1','-D','G5_EARLY_RESIDUAL_RESTART=0',
+                    '-D',f'G5_ANDERSON={enabled}','-E','ph_solve','-Fo',shader,ROOT/'physics.hlsl']
+                w.build(f'anderson-{arm}-{policy}',['physics.hlsl'],[shader.relative_to(ROOT).as_posix()],command)
+                if not enabled:require(digest(shader)==ref['ph_solve.dxil'],'control DXIL differs from retained baseline')
+                r=subprocess.run([sdk()[1],'-dumpbin',shader],capture_output=True,text=True,check=True)
+                (out/f'{arm}-{policy}-dxil.txt').write_text(r.stdout)
+                static[f'{arm}-{policy}']=dict(barriers=r.stdout.count('call void @dx.op.barrier'),
+                    lines=len(r.stdout.splitlines()),raw_buffer_load_sites=sum('@dx.op.rawBufferLoad' in line and 'call ' in line for line in r.stdout.splitlines()),sha256=digest(shader))
