+            selected={a:[r for r in runs if (r['topology'],r['n'],r['policy'],r['arm'])==(topology,n,4,a)] for a in ('control','candidate')}
+            row=dict(topology=topology,n=n,iterations=selected['control'][0]['proof']['solver_iterations'],
+                contacts=selected['control'][0]['proof']['actual_contacts'],candidate_iterations=selected['candidate'][0]['proof']['solver_iterations'],anderson=selected['candidate'][0]['anderson'],candidate_status=selected['candidate'][0]['status'])
