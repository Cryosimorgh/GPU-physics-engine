+                    arm_rows=[r for r in selected if r['arm']==arm]
+                    require(len({r['status'] for r in arm_rows})==1,'nonrepeatable convergence')
+                    require(len({r['proof']['solver_iterations'] for r in arm_rows})==1,'nonrepeatable iterations')
+                    for key in arm_rows[0]['signatures']:
+                        require(len({json.dumps(r['signatures'][key],sort_keys=True) for r in arm_rows})==1,'nonrepeatable arithmetic/result '+key)
+                for key in schedule_keys:
+                    require(len({json.dumps(r['signatures'][key],sort_keys=True) for r in selected})==1,'contact/color input schedule changed '+key)
+                control=next(r for r in selected if r['arm']=='control')
+                candidate=next(r for r in selected if r['arm']=='candidate')
+                if control['status']=='CONVERGED' and candidate['status']!='CONVERGED':
+                    regressions.append(dict(topology=topology,n=n,policy=policy,status=candidate['status']))
+        summary=[];ratio_sets=[]
