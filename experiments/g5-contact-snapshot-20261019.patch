diff --git a/test_contact_snapshot.py b/test_contact_snapshot.py
new file mode 100644
index 0000000..30331d4
--- /dev/null
+++ b/test_contact_snapshot.py
@@ -0,0 +1,21 @@
+"""Source dependency guards; GPU comparison supplies numerical verification."""
+from pathlib import Path
+import unittest
+
+class ContactSnapshotContracts(unittest.TestCase):
+    def test_tangent_uses_mutated_contact_local_bodies(self):
+        source=Path('projected_solver.hlsl').read_text()
+        self.assertIn('#define G5_CONTACT_SNAPSHOT 0',source)
+        self.assertIn('void applySnapshotContact(',source)
+        part=source.split('void applySnapshotContact(',1)[1].split('\n}\n',1)[0]
+        self.assertEqual(part.count('bodyAt('),2)
+        self.assertLess(part.index('deltaSnapshot(o,next-ln,0'),part.index('snapshotRelative(o,a,b,true)'))
+        self.assertIn('inout Body a,inout Body b',source)
+
+    def test_solver_policy_and_barrier_loop_unchanged(self):
+        source=Path('projected_solver.hlsl').read_text()
+        self.assertNotIn('G5_COALESCE_COLOR_BARRIER',source)
+        self.assertNotIn('G5_EARLY_RESIDUAL_RESTART',source)
+        self.assertIn('DeviceMemoryBarrierWithGroupSync();ratio=measure(r,lane,raw);',source)
+
+if __name__=='__main__':unittest.main()
